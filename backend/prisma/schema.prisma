datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  avatar          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  uploadedBooks   Book[]            @relation("UserUploadedBooks")
  userBooks       UserBook[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  summaries       Summary[]
  aiChats         AIChat[]
  flashcards      Flashcard[]
  quizzes         Quiz[]
  audios          Audio[]

  @@map("users")
}

model Book {
  id               String            @id @default(cuid())
  title            String
  author           String
  description      String            @db.Text
  coverUrl         String?           @db.Text
  coverBg          String?           @default("linear-gradient(135deg, #4A3E3D 0%, #2A2120 100%)")
  coverTextColor   String?           @default("#FAF0E6")
  readingTime      String?           @default("3 hrs")
  publicationYear  String?           @default("2026")
  fileUrl          String?           @db.Text
  fileType         String?           @default("EPUB")
  totalPages       Int               @default(100)
  language         String            @default("en")
  category         String            @default("Self Development")
  isAudioAvailable Boolean           @default(true)
  audioDuration    String?           @default("30 mins")
  audioUrl         String?           @db.Text
  uploadedBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  uploader         User?             @relation("UserUploadedBooks", fields: [uploadedBy], references: [id], onDelete: SetNull)
  chapters         Chapter[]
  userBooks        UserBook[]
  readingProgress  ReadingProgress[]
  bookmarks        Bookmark[]
  highlights       Highlight[]
  summaries        Summary[]
  aiChats          AIChat[]
  flashcards       Flashcard[]
  quizzes          Quiz[]
  audios           Audio[]

  @@index([category])
  @@index([uploadedBy])
  @@map("books")
}

model Chapter {
  id            String      @id @default(cuid())
  bookId        String
  title         String
  chapterNumber Int
  readingTime   String?     @default("15 mins")
  summary       String?     @db.Text
  content       String      @db.Text
  createdAt     DateTime    @default(now())

  book          Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  summaries     Summary[]
  bookmarks     Bookmark[]
  audios        Audio[]

  @@index([bookId])
  @@map("chapters")
}

model UserBook {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  isFavorite Boolean  @default(false)
  addedAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("user_books")
}

model ReadingProgress {
  id                 String    @id @default(cuid())
  userId             String
  bookId             String
  currentPage        Int       @default(1)
  currentChapter     Int       @default(0)
  progressPercentage Float     @default(0)
  lastReadAt         DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

model Bookmark {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  page      Int       @default(1)
  chapterId String?
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookId])
  @@map("bookmarks")
}

model Highlight {
  id           String    @id @default(cuid())
  userId       String
  bookId       String
  chapterId    String?
  chapterTitle String?
  text         String    @db.Text
  color        String    @default("yellow")
  note         String?   @db.Text
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("highlights")
}

model Summary {
  id          String    @id @default(cuid())
  userId      String?
  bookId      String
  chapterId   String?
  summaryType String    @default("book") // "quick", "detailed", "keyPoints", "chapter", "book"
  content     String    @db.Text // Can store structured JSON string or plain text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([chapterId])
  @@index([userId])
  @@map("summaries")
}

model AIChat {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  question  String    @db.Text
  answer    String    @db.Text
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("ai_chats")
}

model Flashcard {
  id        String    @id @default(cuid())
  userId    String?
  bookId    String
  question  String    @db.Text
  answer    String    @db.Text
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("flashcards")
}

model Quiz {
  id            String    @id @default(cuid())
  userId        String?
  bookId        String
  question      String    @db.Text
  options       String    @db.Text // JSON array of options string
  correctAnswer String    @db.Text
  explanation   String?   @db.Text
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("quizzes")
}

model Audio {
  id        String    @id @default(cuid())
  userId    String?
  bookId    String
  chapterId String?
  audioUrl  String    @db.Text
  duration  Int?      @default(0)
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([chapterId])
  @@map("audios")
}
