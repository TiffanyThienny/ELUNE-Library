datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum BookStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum BlockType {
  PARAGRAPH
  HEADING
  QUOTE
  LIST
  IMAGE
}

enum ReviewAction {
  APPROVED
  REJECTED
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  avatar          String?
  role            Role              @default(USER)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  uploadedBooks   Book[]            @relation("UserUploadedBooks")
  userBooks       UserBook[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  notes           Note[]
  summaries       Summary[]
  aiChats         AIChat[]
  flashcards      Flashcard[]
  quizzes         Quiz[]
  audioTracks     AudioTrack[]
  reviews         BookUploadReview[] @relation("AdminReviews")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  books       Book[]

  @@map("categories")
}

model Book {
  id               String            @id @default(cuid())
  title            String
  author           String
  description      String            @db.Text
  coverUrl         String?           @db.Text
  coverBg          String?           @default("linear-gradient(135deg, #8C7355 0%, #4A3E3D 100%)")
  coverTextColor   String?           @default("#FAF0E6")
  fileUrl          String?           @db.Text
  fileType         String?           @default("EPUB")
  totalPages       Int               @default(100)
  language         String            @default("en")
  categoryId       String?
  uploadedBy       String?
  visibility       Visibility        @default(PUBLIC)
  status           BookStatus        @default(APPROVED)
  rejectionReason  String?           @db.Text
  processingStatus ProcessingStatus  @default(READY)
  processingError  String?           @db.Text
  isScanned        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploader        User?             @relation("UserUploadedBooks", fields: [uploadedBy], references: [id], onDelete: SetNull)
  chapters        Chapter[]
  userBooks       UserBook[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  notes           Note[]
  summaries       Summary[]
  aiChats         AIChat[]
  flashcards      Flashcard[]
  quizzes         Quiz[]
  audioTracks     AudioTrack[]
  reviews         BookUploadReview[]

  @@index([categoryId])
  @@index([uploadedBy])
  @@index([visibility])
  @@index([status])
  @@index([visibility, status])
  @@map("books")
}

model Chapter {
  id            String         @id @default(cuid())
  bookId        String
  title         String
  chapterNumber Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contentBlocks ContentBlock[]
  bookmarks     Bookmark[]
  notes         Note[]
  summaries     Summary[]
  audioTracks   AudioTrack[]

  @@index([bookId])
  @@map("chapters")
}

model ContentBlock {
  id           String         @id @default(cuid())
  chapterId    String
  blockIndex   Int
  type         BlockType      @default(PARAGRAPH)
  text         String         @db.Text
  pageNumber   Int            @default(1)
  startOffset  Int?           @default(0)
  endOffset    Int?           @default(0)
  createdAt    DateTime       @default(now())

  chapter      Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  bookmarks    Bookmark[]
  notes        Note[]
  audioSegments AudioSegment[]

  @@index([chapterId])
  @@index([pageNumber])
  @@map("content_blocks")
}

model UserBook {
  id         String    @id @default(cuid())
  userId     String
  bookId     String
  isFavorite Boolean   @default(false)
  addedAt    DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("user_books")
}

model ReadingProgress {
  id                   String    @id @default(cuid())
  userId               String
  bookId               String
  currentChapterId     String?
  currentContentBlockId String?
  currentPage          Int       @default(1)
  progressPercentage   Float     @default(0)
  lastReadAt           DateTime  @default(now())

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book                 Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

model Bookmark {
  id             String        @id @default(cuid())
  userId         String
  bookId         String
  chapterId      String
  contentBlockId String
  pageNumber     Int           @default(1)
  note           String?       @db.Text
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter        Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contentBlock   ContentBlock  @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@unique([userId, contentBlockId])
  @@index([userId])
  @@index([bookId])
  @@index([chapterId])
  @@index([contentBlockId])
  @@map("bookmarks")
}

model Note {
  id             String        @id @default(cuid())
  userId         String
  bookId         String
  chapterId      String
  contentBlockId String
  pageNumber     Int           @default(1)
  content        String        @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter        Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contentBlock   ContentBlock  @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([chapterId])
  @@index([contentBlockId])
  @@map("notes")
}

model Summary {
  id          String    @id @default(cuid())
  userId      String?
  bookId      String
  chapterId   String?
  summaryType String    @default("book") // "quick", "detailed", "keyPoints", "chapter", "book"
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([chapterId])
  @@index([userId])
  @@map("summaries")
}

model AIChat {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  question  String    @db.Text
  answer    String    @db.Text
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("ai_chats")
}

model Flashcard {
  id        String    @id @default(cuid())
  userId    String?
  bookId    String
  question  String    @db.Text
  answer    String    @db.Text
  createdAt DateTime  @default(now())

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("flashcards")
}

model Quiz {
  id            String    @id @default(cuid())
  userId        String?
  bookId        String
  question      String    @db.Text
  options       String    @db.Text // JSON array
  correctAnswer String    @db.Text
  explanation   String?   @db.Text
  createdAt     DateTime  @default(now())

  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("quizzes")
}

model AudioTrack {
  id            String         @id @default(cuid())
  bookId        String
  chapterId     String?
  audioUrl      String         @db.Text
  duration      Float          @default(0) // seconds
  createdAt     DateTime       @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  segments      AudioSegment[]

  @@index([bookId])
  @@index([chapterId])
  @@map("audio_tracks")
}

model AudioSegment {
  id             String        @id @default(cuid())
  audioTrackId   String
  contentBlockId String
  startTime      Float         // seconds e.g. 12.5
  endTime        Float         // seconds e.g. 24.8

  audioTrack     AudioTrack    @relation(fields: [audioTrackId], references: [id], onDelete: Cascade)
  contentBlock   ContentBlock  @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@unique([audioTrackId, contentBlockId])
  @@index([audioTrackId])
  @@index([contentBlockId])
  @@map("audio_segments")
}

model BookUploadReview {
  id             String        @id @default(cuid())
  bookId         String
  reviewerId     String
  action         ReviewAction
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  book           Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reviewer       User          @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([reviewerId])
  @@map("book_upload_reviews")
}
